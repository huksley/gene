{
  "name": "geneai",
  "version": "1.8.0",
  "private": true,
  "description": "🧬 Gene AI is an autonomous AI harness powered by Claude Code — from a ticket to a mergeable pull request, completely automated.",
  "type": "module",
  "license": "Apache-2.0",
  "volta": {
    "node": "26.3.0"
  },
  "scripts": {
    "prepg": "if [ ! -d data/pg ]; then mkdir -p data/pg; initdb -D data/pg; fi",
    "pg": "trap 'kill 0' SIGINT; postgres -D data/pg --config-file=pg.conf",
    "gene": "node --experimental-ffi --disable-warning=ExperimentalWarning --env-file-if-exists=.env.development src/index.ts",
    "headless": "node --env-file-if-exists=.env.development src/index.ts --headless",
    "once": "node --env-file-if-exists=.env.development src/index.ts --once",
    "build": "node build.mjs",
    "build:ui": "vite build --config web/vite.config.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "build:mac": "node build.mjs --target darwin-arm64",
    "build:linux": "node build.mjs --target linux-x64,linux-arm64",
    "publish": "node publish.mjs",
    "publish:mac": "node publish.mjs --target darwin-arm64",
    "publish:linux": "node publish.mjs --target linux-x64,linux-arm64",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.13",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@huksley/trello-cli": "^1.0.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@opentui/core": "^0.5.14",
    "chalk": "^5.6.2",
    "cron-parser": "^5.10.1",
    "pg": "^8.21.0",
    "quickjs-emscripten-core": "^0.32.0"
  }
}
