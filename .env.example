# Gene AI pipeline — copy the values you need into .env.development (gitignored).
# Anything left blank falls back to the default shown in the comment.

# --- Linear -------------------------------------------------------------------
# The `linear` CLI is already authenticated (workspace verda-cloud), so a key is
# only needed for non-interactive / CI use. Leave blank to use the CLI's creds.
LINEAR_API_KEY=

# Target Linear workspace slug passed to the CLI as `-w` (default: linear's default).
GENE_LINEAR_WORKSPACE=verda-cloud

# --- Issue selection + lifecycle ---------------------------------------------
# Issues carrying this label (and in GENE_TRIGGER_STATE) are picked up.
# The label is an ownership tag and is NEVER removed by the pipeline.
GENE_LABEL=Gene

# Workflow state names (must match the team's states exactly).
GENE_TRIGGER_STATE=Todo
GENE_ACTIVE_STATE=In Progress
GENE_BLOCKED_STATE=Blocked
GENE_REVIEW_STATE=In Review

# Signature appended to every comment Gene writes, so the daemon can tell its own
# comments from human replies (the CLI posts as your user). Keep it distinctive.
GENE_AGENT_MARKER="#gene-ai"

# Comma-separated markdown headings required in a description before work starts
# (e.g. "## Problem,## Acceptance criteria"). Empty = don't enforce.
GENE_REQUIRE_SECTIONS=

# --- Repo targeting (per issue) ----------------------------------------------
# An issue picks its repo by including a GitLab or GitHub link in its description
# (the FIRST link wins; comments are checked as a fallback). The forge is inferred
# from the host (gitlab.* -> glab, github.com -> gh), and a monorepo subdir is
# read from a /tree/<branch>/<path> URL. Examples:
#   https://gitlab.datacrunch.io/datacrunch/nest.datacrunch.io                 (whole repo)
#   https://gitlab.datacrunch.io/datacrunch/web-apps/-/tree/main/apps/console  (subdir)
#   https://github.com/verda-cloud/sdk-python                                  (github)
# GITLAB_HOST=

# Per-team default repo for issues with NO link — JSON object of team key -> URL.
# Merged over the built-in default {"CLOUD":"https://<host>/datacrunch/nest.datacrunch.io"}.
GENE_REPO_MAP=

# --- Local clones + daemon ---------------------------------------------------
# Where target repos are cloned and kept (relative to this repo root).
GENE_REPOS_DIR=repos
GENE_POLL_INTERVAL_MS=60000
GENE_DEBOUNCE_MS=30000
GENE_MAX_CONCURRENT=2

# Log-only: when true, no Linear/GitLab writes and no agent spawns. Flip to false
# to go live.
GENE_DRY_RUN=true
GENE_CLAUDE_BIN=claude

# Retry a `claude -p` spawn that exits non-zero from a transient API/socket error,
# this many times, with exponential backoff starting at GENE_AGENT_RETRY_DELAY_MS.
# The worktree persists between attempts, so a retry resumes prior work. 0 = off.
GENE_AGENT_MAX_RETRIES=2
GENE_AGENT_RETRY_DELAY_MS=5000

# --- Optional ----------------------------------------------------------------
# Stripped from the agent's environment so `claude` uses your OAuth (Max) session
# instead of billing an API key. Set only if it leaks in from your shell profile.
ANTHROPIC_API_KEY=
