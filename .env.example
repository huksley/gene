# Gene AI pipeline — copy the values you need into .env.development (gitignored).
# Anything left blank falls back to the default shown in the comment.

# --- Tracker selection -------------------------------------------------------
# Which issue tracker Gene drives: "linear" or "trello" (default: linear).
# Tracker-specific settings are namespaced by the active tracker's prefix
# (LINEAR_* / TRELLO_*); only the block matching GENE_TRACKER is read, so you can
# keep both blocks filled in and switch backends with this one knob.
GENE_TRACKER=linear

# --- Linear backend (read when GENE_TRACKER=linear) --------------------------
# The `linear` CLI may already be authenticated, so a key is only needed for
# non-interactive / CI use. Leave blank to use the CLI's creds.
LINEAR_API_KEY=

# Target Linear workspace slug passed to the CLI as `-w` (default: linear's default).
LINEAR_WORKSPACE=

# Issues carrying this label (and in LINEAR_TRIGGER_STATE) are picked up. The
# label is an ownership tag and is NEVER removed by the pipeline.
LINEAR_LABEL=Gene

# Whom Gene works for. Only issues assigned to this user are picked up:
#   me          the authenticated Linear user (default)
#   any         no assignee filter — every Gene issue, including unassigned
#   <email>     a specific assignee, e.g. teammate@example.com
LINEAR_ASSIGNEE=me

# Workflow state names (must match the team's states exactly).
LINEAR_TRIGGER_STATE=Todo
LINEAR_ACTIVE_STATE=In Progress
LINEAR_BLOCKED_STATE=Blocked
LINEAR_REVIEW_STATE=In Review
# Optional terminal state: when set, an In-Review issue whose change request has
# merged is auto-moved here (with a comment). Unset = merge→Done stays manual.
# LINEAR_DONE_STATE=Done

# --- Trello backend (read when GENE_TRACKER=trello) --------------------------
# The bundled ./trello wrapper manages Trello cards ("issues") + comments.
# Trello auth needs BOTH a key AND a token (a key alone gets 401):
#   key   — https://trello.com/power-ups/admin → your Power-Up → "API key" tab
#   token — the "Token" link on that page, or the authorize URL in trello/README.md
TRELLO_API_KEY=
TRELLO_TOKEN=
# Trello OAuth secret (the "Secret" on the same Power-Up API key page), used only
# to verify webhook HMAC signatures. Needed only if you enable the webhook below.
TRELLO_API_SECRET=

# The board whose cards Gene watches (REQUIRED when GENE_TRACKER=trello). This is
# the board id (or shortLink) — list yours with `npm run trello -- boards`.
TRELLO_BOARD=

# Optional JSON map of state-name → list-id, overriding the by-name list lookup.
# Use it when your board's list names differ from the *_STATE values below, or to
# pin lists by id:  TRELLO_LIST_MAP={"Todo":"<listId>","In Review":"<listId>"}
TRELLO_LIST_MAP=

# Optional: override the API base (default https://api.trello.com/1).
# TRELLO_API_BASE_URL=

# Cards carrying this label are picked up. Ownership tag — NEVER removed by Gene.
TRELLO_LABEL=Gene

# Whom Gene works for (Trello exposes usernames, not emails):
#   me            the authenticated Trello user is a member of the card (default)
#   any           no assignee filter
#   <username>    a specific Trello username
TRELLO_ASSIGNEE=me

# Lifecycle states are Trello *list* names — a card's list is its state. The list
# names on your board must match these (or remap them via TRELLO_LIST_MAP above).
TRELLO_TRIGGER_STATE=Todo
TRELLO_ACTIVE_STATE=In Progress
TRELLO_BLOCKED_STATE=Blocked
TRELLO_REVIEW_STATE=In Review
# Optional terminal list: when set, a card in review whose PR/MR has merged is
# auto-moved here (with a comment). Unset = merge→Done stays manual.
# TRELLO_DONE_STATE=Done

# --- Trello webhook (optional, low-latency reactivity) -----------------------
# Polling reacts within GENE_POLL_INTERVAL_MS; a webhook drops that to seconds.
# Point a tunnel at the local listener, put its public URL here, then register
# with `npm run webhook`. Unset = poll-only. Requires TRELLO_API_SECRET (above).
#   cloudflared tunnel --url http://localhost:8473   # prints an https URL
# GENE_WEBHOOK_URL=https://your-tunnel.trycloudflare.com
# GENE_WEBHOOK_PORT=8473

# --- Comment marker + description gate (tracker-neutral) ---------------------
# Signature appended to every comment Gene writes, so the daemon can tell its own
# comments from human replies (it posts as your user). Keep it distinctive.
GENE_AGENT_MARKER="#gene-ai"

# Command base for directives. Overrides the default "!gene" with the GENE_COMMAND_BASE environment variable.
GENE_COMMAND_BASE="!gene"

# Template for the branch Gene works on. Placeholders: {prefix}, {identifier},
# {slug} (the issue title, slugified). {prefix} is taken from the tracker when it
# supplies one (Linear's suggested branch name carries a label-based prefix);
# otherwise it falls back to GENE_COMMAND_BASE stripped to alphanumerics ("!gene" →
# "gene"). An empty slug collapses the trailing "-{slug}" (e.g. "fix/abc-123").
GENE_BRANCH_TEMPLATE="{prefix}/{identifier}-{slug}"

# Comma-separated markdown headings required in a description before work starts
# (e.g. "## Problem,## Acceptance criteria"). Empty = don't enforce.
GENE_REQUIRE_SECTIONS=

# --- Comment ignore patterns (tracker + forge, all optional) -----------------
# Comments matching any pattern here do NOT wake Gene: a matching comment on the
# issue isn't treated as new human feedback (LINEAR_/TRELLO_), and a matching
# review comment on the MR/PR neither re-triggers the agent nor is shown to it
# (GITLAB_/GITHUB_). The forge keys are NOT prefix-namespaced — the forge is chosen
# per issue, so set whichever you use.
#
# Each value is a comma-separated list; every item is either:
#   - a bare string   → case-insensitive SUBSTRING match (broad: "review" also
#                       matches "preview" and "please review it")
#   - a /regexp/flags → JS regex, full test (anchor it to narrow, e.g. /^lgtm$/i;
#                       commas inside the slashes are kept, e.g. /a{1,2}/)
# Built-ins are always active (no need to list them) and your patterns add to them:
#   all sources → !review, /review        Linear also → Review
# Example: GITLAB_IGNORE_COMMENTS=/^\/(approve|lgtm)\b/i, ci: skip
LINEAR_IGNORE_COMMENTS=
TRELLO_IGNORE_COMMENTS=
GITLAB_IGNORE_COMMENTS=
GITHUB_IGNORE_COMMENTS=

# --- Repo targeting (per issue) ----------------------------------------------
# An issue picks its repo by including a GitLab or GitHub link in its description
# (the FIRST link wins; comments are checked as a fallback). The forge is inferred
# from the host (gitlab.* -> glab, github.com -> gh), and a monorepo subdir is
# read from a /tree/<branch>/<path> URL. Examples:
#   https://gitlab.com/example/example-repo                           (whole repo)
#   https://gitlab.com/example/example-repo/-/tree/main/path/to/dir   (subdir)
#   https://github.com/example/example-repo                           (github)
# GITLAB_HOST=

# Default repo URL, used when an issue carries no link and no GENE_REPO_MAP is set.
# If not set and no GENE_REPO_MAP is set, the issue description is checked for a link.
# If no link is found, the issue is skipped.
# GENE_REPO_URL=https://gitlab.com/example/example-repo

# Per-team default repo for issues with NO link — JSON object of team key -> URL.
# Merged over the built-in default i.e. {"TEAM": "https://github.com/example/example-repo"}.
# (Trello cards carry no team; put a board-wide default under the "" key.)
# GENE_REPO_MAP=

# --- Local clones + daemon ---------------------------------------------------
# Where target repos are cloned and kept (relative to this repo root).
GENE_REPOS_DIR=repos
GENE_POLL_INTERVAL_MS=60000
GENE_DEBOUNCE_MS=30000
GENE_MAX_CONCURRENT=2

# Log-only: when true, no tracker/forge writes and no agent spawns. Flip to false
# to go live.
GENE_DRY_RUN=true

# Open every change request as a DRAFT (`glab mr create --draft` / `gh pr create
# --draft`). When true, Gene also never marks a CR ready itself — a human reviews,
# marks it ready, and merges (the "ready" step becomes a human gate). Applies to
# both forges. Default false (Gene opens ready-for-review CRs).
GENE_DRAFT_CHANGE_REQUEST=false
GENE_CLAUDE_BIN=claude

# Retry a `claude -p` spawn that exits non-zero from a transient API/socket error,
# this many times, with exponential backoff starting at GENE_AGENT_RETRY_DELAY_MS.
# The worktree persists between attempts, so a retry resumes prior work. 0 = off.
GENE_AGENT_MAX_RETRIES=2
GENE_AGENT_RETRY_DELAY_MS=5000

# Hard cap on a single agent run's wall-clock time, in SECONDS (default 1800 = 30
# min). When a run exceeds it the spawn is killed (SIGTERM, then SIGKILL after a
# short grace) and, if it still has retries left (above), restarted from its
# worktree. Set 0 to disable the timeout (let an agent run for as long as it needs).
GENE_AGENT_MAX_PROCESSING_TIME=1800

# --- State store -------------------------------------------------------------
# The daemon keeps its bookkeeping (review cursor + per-issue activity log) in
# Postgres. By DEFAULT this is EMBEDDED — an in-process Postgres (PGlite) with its
# data under ~/.config/gene/pgdata (XDG-aware). Zero setup: no server to install or
# run, and NONE of the vars below are needed. It is single-process, though, so a
# one-shot `npm run log` / `npm run reset` can't run while the daemon holds it.
# GENE_DB_DIR=/custom/path     # override the embedded data dir
#
# To use a Postgres SERVER instead — required for concurrent access (daemon + a
# one-shot at the same time) — set EITHER a full URL or any PG* var below. Setting
# any of them flips Gene to server mode. `npm run pg` init-and-runs a throwaway local
# one on 127.0.0.1:5434 (data under data/pg, config in pg.conf) with trust auth for
# the local OS user.
# DATABASE_URL=postgres://$USER:postgres@127.0.0.1:5434/postgres
# ...or the discrete pieces (consulted only when DATABASE_URL is unset):
# PGHOST=127.0.0.1
# PGPORT=5434
# PGDATABASE=postgres
# PGUSER=$USER
# PGPASSWORD=postgres

# --- Optional ----------------------------------------------------------------
# Stripped from the agent's environment so `claude` uses your OAuth (Max) session
# instead of billing an API key. Set only if it leaks in from your shell profile.
ANTHROPIC_API_KEY=

# Use Claude API-billing - will pass the ANTHROPIC_API_KEY to the agent's environment
GENE_CLAUDE_API_BILLING=false

# Comma-separated list of additional tools to allow the agent to use, on top of
# the built-in base set and the forge's own CLI (gh/glab are already granted per
# issue). Use it to let the agent run your project's build/test commands, e.g.
# Example: GENE_ALLOWED_TOOLS="Bash(cmake *),Bash(bun *)"
# GENE_ALLOWED_TOOLS=

# --- Plugins (optional) ------------------------------------------------------
# Lifecycle observers, loaded at startup. Comma-separated list of module paths
# and/or directories (relative to the repo root). Each module default-exports a
# Plugin (or a factory returning one); a directory loads every non-test *.ts/*.js
# inside it. Plugins receive events — agent-started, agent-finished,
# issue-status-changed, pr-created, ci-completed — and are pure observers: a bad
# plugin is isolated and never breaks the pipeline. See src/plugins/index.ts.
# The bundled example just logs every event:
# GENE_PLUGINS=src/plugins/examples/logging.ts
#
# Bundled DollarDeploy plugin: on a ticket's change request passing CI it duplicates
# the repo's dev/staging app into a per-ticket preview (named <repo>-<ticket-id>, on
# the ticket's branch + a custom subdomain) and deploys it; it removes that preview
# when the ticket is moved to Done. Needs a DollarDeploy API key (or `ddc auth`).
# GENE_PLUGINS=src/plugins/dollardeploy.ts
# DOLLARDEPLOY_API_KEY=sk_...            # else read from ~/.dollardeploy/auth
# DOLLARDEPLOY_BASE_URL=https://dollardeploy.com
# DOLLARDEPLOY_REQUIRE_CI=false          # true = wait for CI to pass; default deploys on CR creation

# --- Sandbox (optional) ------------------------------------------------------
# Run each spawned agent inside an isolated microsandbox VM (sandbox/sandbox.sh)
# instead of directly on the host, so an agent can't reach your machine or the
# wider network. Off by default. Build the image once first:
#   ./sandbox/sandbox.sh base
# When on, the daemon runs the agent as:
#   sandbox/sandbox.sh run --inherit -v <repos>:<repos> -w <worktree> -- claude -p …
# The repos dir is mounted at its REAL host path (not via --dir, which would remap
# it and break the worktree's git link to its parent clone, taking git/gh/glab down
# with it); --inherit carries your claude/gh/glab/linear/trello login into the VM
# and enables internal networking for on-prem forges. Tune the VM with the
# GENE_SANDBOX_* vars (memory, CPUs, read-only auth, …) — see sandbox/README.md.
# NOTE (macOS): if you raise GENE_MAX_CONCURRENT above 1, also set
# GENE_SANDBOX_KEEP_CREDENTIALS=1 — otherwise the first agent to finish deletes the
# bridged Claude credentials file that its still-running siblings are reading.
GENE_SANDBOX=false
